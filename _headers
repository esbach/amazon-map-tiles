
/areas/*.pmtiles
  Content-Type: application/octet-stream
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/limits/*.pmtiles
  Content-Type: application/octet-stream
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
  
# Enable CORS for all tile files in ecuador_v1
/ecuador_v14/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *
  Cache-Control: public, max-age=31536000, immutable

# Enable CORS for PNG files specifically
/*.png
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *
  Cache-Control: public, max-age=31536000, immutable

# Enable CORS for JSON files (like tile_info.json)
/*.json
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *
  Cache-Control: public, max-age=3600

# Also enable CORS for the tiles subdirectory (if it exists)
/tiles/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *
  Cache-Control: public, max-age=31536000, immutable

# General CORS for the entire site
/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

